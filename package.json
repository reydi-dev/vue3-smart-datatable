{
  "name": "@reydi-dev/vue3-smart-datatable",
  "version": "0.0.0",
  "private": true,
  "description": "A TypeScript-ready Vue 3 data table with local/async data, responsive layouts, RTL, typed slots and CSV.",
  "license": "MIT",
  "author": "Mohammad Reza Dehghani",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reydi-dev/vue3-smart-datatable.git"
  },
  "bugs": {
    "url": "https://github.com/reydi-dev/vue3-smart-datatable/issues"
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/smart-data-table.js"
    },
    "./styles.css": "./dist/smart-data-table.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "node scripts/check-doc-examples.mjs && vue-tsc --noEmit -p tsconfig.json && node scripts/check-contract-errors.mjs",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:components": "vitest run --config vitest.components.config.ts",
    "test:e2e": "playwright test",
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "test:dist": "node --test tests/consumers/distribution.test.mjs",
    "build:demo": "vite build --config vite.demo.config.ts && node scripts/check-demo-output.mjs",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run test:components && npm run build && npm run test:dist && npm run build:demo",
    "test:consumer": "node scripts/check-packed-consumer.mjs",
    "preview:consumer": "node scripts/check-packed-consumer.mjs --preview",
    "preview:demo": "vite preview --config vite.demo.config.ts"
  },
  "peerDependencies": {
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue": "3.5.44",
    "vue-tsc": "3.3.13"
  }
}
